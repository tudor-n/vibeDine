HOST=0.0.0.0
PORT=8000
APP_ENV=development
LOG_LEVEL=info
GEMINI_API_KEY=your-gemini-api-key-here

# Menu digitalization
# Vision provider for menu photo extraction: "gemini" (default) | "claude"
AI_VISION_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# Claude alternative — only used when AI_VISION_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Item photo extraction (opt-in second vision pass that crops dish photos).
# Gemini-only; no-ops unless AI_VISION_PROVIDER=gemini and GEMINI_API_KEY is set.
# Model falls back to GEMINI_VISION_MODEL, then gemini-3.1-flash-lite.
GEMINI_ITEM_PHOTO_MODEL=
# Per-PDF-job cap on pages sent to the photo detector (default 50).
ITEM_PHOTO_MAX_PAGES=50