{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "test-issuer",
    "Audience": "test-audience",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "MenuImport": {
    "MaxConcurrentJobs": 3,
    "PollIntervalMs": 2000,
    "MaxFileBytes": 110000000,
    "CallbackBaseUrl": "http://localhost:5005",
    "DefaultProvider": "gemini",
    "StaleAfterMinutes": 5
  },
  "CustomerSession": {
    "LinkExpirySeconds": 900,
    "SessionLifetimeMinutes": 180
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "UseSsl": false,
    "FromAddress": "no-reply@smart-restaurant.local",
    "FromName": "Smart Restaurant"
  },
  "App": {
    "AdminBaseUrl": "http://localhost:3001"
  }
}
