# Build context must be the REPO ROOT (not frontend-customer/): the app imports
# @shared/* which aliases to ../shared at the repo root.
# On Railway: leave Root Directory empty and set RAILWAY_DOCKERFILE_PATH=frontend-customer/Dockerfile.railway
FROM node:20-alpine AS build
WORKDIR /app/frontend-customer
COPY frontend-customer/package.json frontend-customer/package-lock.json ./
RUN npm ci
COPY shared/ /app/shared/
COPY frontend-customer/ ./
# Vite bakes VITE_* vars into the bundle at build time. Railway passes service
# variables to Docker builds only if they are declared as ARGs.
ARG VITE_API_URL
ARG VITE_WS_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
RUN npm run build-only

FROM node:20-alpine
WORKDIR /app
# Not a static file server (`serve`) any more: server/index.js does the SPA
# fallback AND inlines the scanned table's brand colours into index.html, so a
# first-ever scan paints the right theme instead of flashing the default one.
# It needs BRANDING_API_URL at RUNTIME (unlike VITE_* which are baked at build) —
# point it at the API's internal Railway URL. Unset = pages serve unbranded.
COPY frontend-customer/server/package.json frontend-customer/server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev
COPY frontend-customer/server/index.js ./server/
COPY --from=build /app/frontend-customer/dist ./dist
EXPOSE 3000
CMD ["node", "server/index.js"]
