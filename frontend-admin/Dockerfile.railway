# Build context must be the REPO ROOT (not frontend-admin/): the app imports
# @shared/* which aliases to ../shared at the repo root.
# On Railway: leave Root Directory empty and set RAILWAY_DOCKERFILE_PATH=frontend-admin/Dockerfile.railway
FROM node:20-alpine AS build
WORKDIR /app/frontend-admin
COPY frontend-admin/package.json frontend-admin/package-lock.json ./
RUN npm ci
COPY shared/ /app/shared/
COPY frontend-admin/ ./
# Vite bakes VITE_* vars into the bundle at build time. Railway passes service
# variables to Docker builds only if they are declared as ARGs.
ARG VITE_API_URL
ARG VITE_CUSTOMER_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_CUSTOMER_URL=$VITE_CUSTOMER_URL
RUN npm run build

FROM node:20-alpine
WORKDIR /app
RUN npm install -g serve@14
COPY --from=build /app/frontend-admin/dist ./dist
EXPOSE 3000
# -s = SPA fallback: every route (/login, /tables, ...) serves index.html
CMD ["serve", "-s", "dist", "-l", "tcp://0.0.0.0:3000"]
